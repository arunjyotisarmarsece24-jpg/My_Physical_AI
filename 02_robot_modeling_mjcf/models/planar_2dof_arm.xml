<mujoco model="planar_2dof_arm">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8"/>
  </visual>

  <default>
    <joint damping="0.1" armature="0.01"/>
    <geom friction="0.8 0.1 0.1"/>
  </default>

  <worldbody>
    <light diffuse=".8 .8 .8" pos="0 0 4" dir="0 0 -1"/>
    <geom type="plane" size="2 2 0.1" rgba="0.92 0.92 0.92 1"/>

    <!-- Pedestal Base -->
    <body name="base" pos="0 0 0.5">
      <geom type="cylinder" size="0.08 0.25" rgba="0.3 0.3 0.3 1"/>

      <!-- Link 1 (Shoulder) -->
      <body name="link1" pos="0 0 0.25">
        <joint name="shoulder_joint" type="hinge" axis="0 1 0" range="-2.5 2.5"/>
        <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.03" rgba="0.2 0.5 0.8 1" mass="1.5"/>

        <!-- Link 2 (Elbow) -->
        <body name="link2" pos="0.4 0 0">
          <joint name="elbow_joint" type="hinge" axis="0 1 0" range="-2.8 2.8"/>
          <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.025" rgba="0.8 0.3 0.2 1" mass="1.0"/>

          <!-- End-Effector Tip (Site for Kinematics / Jacobian calculation) -->
          <site name="end_effector" pos="0.35 0 0" size="0.03" rgba="0.1 0.9 0.2 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder_joint" gear="1" ctrllimited="true" ctrlrange="-50 50"/>
    <motor name="elbow_motor" joint="elbow_joint" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
  </actuator>
</mujoco>
